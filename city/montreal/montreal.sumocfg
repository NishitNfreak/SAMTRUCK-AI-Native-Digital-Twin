<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="concordia_sgw_region.net.xml"/>
        <route-files value="vehicle_types.rou.xml,city_traffic.rou.xml"/>
        <additional-files value="concordia_sgw_region.poly.xml"/>
        <gui-settings-file value="view.settings.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="90"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <time-to-teleport value="-1"/>
        <ignore-junction-blocker value="5"/>
        <lanechange.overtake-right value="true"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
</configuration>
